{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",
    "outDir": ".pipeline-test",
    "jsx": "react",
    "incremental": false,
    "plugins": []
  },
  "include": [
    "lib/latex/**/*.ts",
    "lib/profiles/**/*.ts",
    "lib/access.ts",
    "lib/coverage.ts",
    "lib/keyword-evidence.ts",
    "lib/normalize-changes.ts",
    "lib/resume-doc.ts",
    "lib/import/**/*.ts",
    "lib/tailor/**/*.ts",
    "lib/run-optimization.ts",
    "lib/billing/plans.ts",
    "lib/billing/quota.ts",
    "lib/billing/types.ts",
    "lib/billing/signatures.ts",
    "lib/billing/events.ts",
    "lib/billing/config.ts",
    "types/resume.ts"
  ]
}
