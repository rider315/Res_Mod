{
  "manifest_version": 3,
  "name": "Chills — tailor your resume to this job",
  "version": "1.0.0",
  "description": "Score your resume against the job you're looking at, save it, and start a tailoring in Chills without copying anything.",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Chills",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": ["storage", "identity", "sidePanel", "scripting", "activeTab", "tabs"],
  "host_permissions": [
    "https://chills.pro/*",
    "https://www.linkedin.com/*",
    "https://www.naukri.com/*",
    "https://*.indeed.com/*",
    "https://internshala.com/*",
    "https://wellfound.com/*",
    "https://*.glassdoor.co.in/*",
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
