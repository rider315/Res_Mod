# ── Google OAuth (sign-in + Docs/Drive access) ─────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── NextAuth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── OpenRouter (default AI provider) ───────────────────────────────────────
# Create a key at https://openrouter.ai/keys — it looks like sk-or-v1-...
# Can also be set per-browser from the in-app Settings dialog.
OPENROUTER_API_KEY=

# Model used when nothing is selected in Settings.
# Browse ids at https://openrouter.ai/models — ":free" models cost nothing.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional attribution headers shown on your OpenRouter activity page.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=ResMod Resume Optimizer

# ── Alternate providers (all optional) ─────────────────────────────────────
# Every key below can also be entered in-app under Settings instead.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://cloud.sambanova.ai
SAMBANOVA_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Ollama runs locally and needs no key. Override only if it isn't on the default port.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Puter needs no key — it runs in the browser and bills the signed-in Puter account.
