# ── Google OAuth (sign-in + Docs/Drive access) ─────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── NextAuth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── OpenRouter (default AI provider) ───────────────────────────────────────
# Create a key at https://openrouter.ai/keys — it looks like sk-or-v1-...
# Can also be set per-browser from the in-app Settings dialog.
OPENROUTER_API_KEY=

# Model used when nothing is selected in Settings.
# Browse ids at https://openrouter.ai/models — ":free" models cost nothing.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional attribution headers shown on your OpenRouter activity page.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=ResMod Resume Optimizer

# ── Alternate providers (optional) ─────────────────────────────────────────
GEMINI_API_KEY=
CEREBRAS_API_KEY=
