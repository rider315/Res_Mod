# ── Google OAuth (sign-in only) ────────────────────────────────────────────
# Scopes are just openid/email/profile — the app reads your resume from
# resumes/*.tex and never touches Google Docs or Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LaTeX compilation (optional) ───────────────────────────────────────────
# "Compile PDF" posts the .tex to a LaTeX-as-a-service endpoint, because no
# local TeX install is assumed. Defaults to https://texlive.net/cgi-bin/latexcgi.
# Point this at your own texlive CGI to keep documents in-house. Downloading
# the .tex and compiling it yourself never sends anything anywhere.
# LATEX_COMPILE_URL=

# ── NextAuth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Access ─────────────────────────────────────────────────────────────────
# Google accounts that get the owner workflow: the resume profiles and the
# server-side provider keys below. Comma-separated; defaults to the platform
# owner when unset. Everyone else must use their own key.
# OWNER_EMAILS=

# ── Contact ────────────────────────────────────────────────────────────────
# The address /contact shows for questions, refunds and data requests.
# Razorpay's website review looks for one. Until it is set, the page says no
# address has been published.
# CONTACT_EMAIL=

# ── Database (Neon Postgres) ───────────────────────────────────────────────
# Added to Vercel by the Neon integration; copy both into .env.local. The app
# uses the pooled DATABASE_URL; `npm run db:migrate` and `npm run db:seed-owner`
# use the direct DATABASE_URL_UNPOOLED.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── ResMod AI: included runs for regular accounts ──────────────────────────
# The model accounts use when they don't bring their own key. Each tailoring
# run on it spends one included run: the free monthly runs, a Pro plan's runs,
# or purchased credits (prices and limits in lib/billing/plans.ts). Imports on
# it cost no run but are capped per month. Until ResMod AI is set, included
# runs and payments stay switched off.
#
# Set it in the app: the owner's dashboard → AI settings → "ResMod AI for your
# users". That choice is stored in the database for each deployment, with its
# key encrypted using NEXTAUTH_SECRET. The variables below are only needed to
# override it; the local billing checks use them to point at a stand-in model.
# PLATFORM_AI_PROVIDER=gemini
# PLATFORM_AI_MODEL=gemini-2.5-flash
# PLATFORM_AI_KEY=
# FREE_RUNS_PER_MONTH=5

# ── Razorpay (payments) ────────────────────────────────────────────────────
# API keys from the Razorpay Dashboard. Use the rzp_test_ pair until the
# account is activated: test mode moves no real money.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# The id of a monthly plan created under Subscriptions in the Dashboard. Its
# price must equal PRO_PLAN in lib/billing/plans.ts, or subscribing is refused.
# RAZORPAY_PRO_PLAN_ID=
# Add a webhook in the Dashboard pointing at https://<your domain>/api/billing/webhook
# with the events payment.captured, order.paid and every subscription.* event,
# and put the secret you give it here.
# RAZORPAY_WEBHOOK_SECRET=

# ── OpenRouter (default AI provider) ───────────────────────────────────────
# Create a key at https://openrouter.ai/keys — it looks like sk-or-v1-...
# Can also be set per-browser from the in-app Settings dialog.
OPENROUTER_API_KEY=

# Model used when nothing is selected in Settings.
# Browse ids at https://openrouter.ai/models — ":free" models cost nothing.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional attribution headers shown on your OpenRouter activity page.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=ResMod Resume Optimizer

# ── Alternate providers (all optional) ─────────────────────────────────────
# Every key below can also be entered in-app under Settings instead.

# Claude API — https://platform.claude.com/settings/keys (looks like sk-ant-...)
ANTHROPIC_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://cloud.sambanova.ai
SAMBANOVA_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Ollama runs locally and needs no key. Override only if it isn't on the default port.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Puter needs no key — it runs in the browser and bills the signed-in Puter account.
